# Copy to .dev.vars for local dev (gitignored). In production set these as Pages secrets.

SESSION_SECRET=any-long-random-string
# AI for /api/parse (voice → Do's). Gemini is used when its key is set (free tier at https://aistudio.google.com/apikey);
# otherwise Claude if ANTHROPIC_API_KEY is set.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=sk-ant-...
